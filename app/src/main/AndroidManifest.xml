<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.midi" android:required="true" />
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!--
      Needed only for the round-trip latency probe: the CP-88 is a 2-in/2-out
      interface, so the app can send a click and listen for it coming back,
      measuring its own latency exactly. Nothing is recorded or stored.
      The app runs normally if this is denied.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      The instrument keeps playing when the activity is not in front.
      onPause() used to stop the stream, which meant a power button caught with
      a sleeve, a system dialog, an alarm or an incoming call killed the sound
      mid-song. A mediaPlayback foreground service is the supported way to tell
      Android that this process is producing audio someone is listening to; see
      EngineService for the whole argument.

      POST_NOTIFICATIONS is for the service's own notification on API 33+.
      Refusing it is not fatal, because the service still runs, but the Stop
      button on that notification is the only way out of the instrument short of
      killing the app, so it is worth asking for.

      (Note for the next person: a double hyphen is illegal inside an XML
      comment, which is why this paragraph reads the way it does.)
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WAKE_LOCK, for the direct-USB modes. AudioFlinger holds a wake lock for any
      app with an active AudioTrack; the direct modes have none, so EngineService
      holds one itself. Without it a foreground service keeps the process
      uncached but lets the SoC sleep.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Bag-O-Synths"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              USB audio and MIDI devices. This is what lets "always open with
              Bag-O-Synths" grant USB permission once and for all, so that a
              replugged piano in a direct-USB mode comes back without a dialog
              in the middle of a set. singleTask above makes the attach land on
              the running instrument (onNewIntent) instead of starting a second
              one; the usbhost prototype measured what a second instance does:
              it fights the first for the interfaces and kills its stream.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio_devices" />
        </activity>

        <service
            android:name=".EngineService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
