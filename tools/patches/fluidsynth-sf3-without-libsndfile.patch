@@ -2736,6 +2736,101 @@ error_exit:
     sf_close(sndfile);
     return -1;
 }
+#elif defined(BAGOSYNTHS_STB_VORBIS)
+
+/* SF3 without libsndfile.
+ *
+ * FluidSynth reaches for libsndfile purely to turn one Ogg Vorbis stream into
+ * 16-bit mono PCM. Doing that with libsndfile means also building libogg and
+ * libvorbis, three dependencies for one codec call, so instead the host
+ * supplies the decoder and this file keeps the part that is genuinely
+ * FluidSynth's: finding the bytes inside the SoundFont.
+ *
+ * Supplied by the host (see cpp/fluid/fluid_glue.c), which wraps stb_vorbis.
+ * Returns frames decoded, 0 for an empty sample, or -1 on error, and sets
+ * *out to a buffer that bagosynths_ogg_free() releases.
+ */
+extern int bagosynths_ogg_decode_mono16(const void *ogg, int len, short **out, int *channels);
+extern void bagosynths_ogg_free(short *pcm);
+
+static int fluid_sffile_read_vorbis(SFData *sf, unsigned int start_byte, unsigned int end_byte, short **data)
+{
+    unsigned char *ogg;
+    short *decoded = NULL;
+    short *wav_data;
+    unsigned int len;
+    int frames, channels = 0, ok;
+
+    *data = NULL;
+
+    if((start_byte > sf->samplesize) || (end_byte > sf->samplesize) || (end_byte < start_byte))
+    {
+        FLUID_LOG(FLUID_ERR, "Ogg Vorbis data offsets exceed sample data chunk");
+        return -1;
+    }
+
+    len = end_byte - start_byte + 1;
+    ogg = FLUID_ARRAY(unsigned char, len);
+
+    if(ogg == NULL)
+    {
+        FLUID_LOG(FLUID_PANIC, "Out of memory");
+        return -1;
+    }
+
+    fluid_rec_mutex_lock(sf->mtx);
+    ok = (sf->fcbs->fseek(sf->sffd, sf->samplepos + start_byte, SEEK_SET) != FLUID_FAILED)
+         && (sf->fcbs->fread(ogg, len, sf->sffd) != FLUID_FAILED);
+    fluid_rec_mutex_unlock(sf->mtx);
+
+    if(!ok)
+    {
+        FLUID_LOG(FLUID_ERR, "Failed to read compressed sample data");
+        FLUID_FREE(ogg);
+        return -1;
+    }
+
+    frames = bagosynths_ogg_decode_mono16(ogg, (int)len, &decoded, &channels);
+    FLUID_FREE(ogg);
+
+    if(frames < 0)
+    {
+        FLUID_LOG(FLUID_ERR, "Failed to decompress Ogg Vorbis sample");
+        return -1;
+    }
+
+    if(frames == 0)
+    {
+        FLUID_LOG(FLUID_DBG, "Empty decompressed sample");
+        bagosynths_ogg_free(decoded);
+        return 0;
+    }
+
+    if(channels != 1)
+    {
+        FLUID_LOG(FLUID_DBG, "Unsupported channel count %d in ogg sample", channels);
+        bagosynths_ogg_free(decoded);
+        return -1;
+    }
+
+    /* The decoder has its own allocator, and FluidSynth releases this buffer
+       with FLUID_FREE -- so hand back one that came from FLUID_ARRAY. */
+    wav_data = FLUID_ARRAY(short, frames);
+
+    if(wav_data == NULL)
+    {
+        FLUID_LOG(FLUID_PANIC, "Out of memory");
+        bagosynths_ogg_free(decoded);
+        return -1;
+    }
+
+    FLUID_MEMCPY(wav_data, decoded, (size_t)frames * sizeof(short));
+    bagosynths_ogg_free(decoded);
+
+    *data = wav_data;
+    return frames;
+}
+
 #else
 static int fluid_sffile_read_vorbis(SFData *sf, unsigned int start_byte, unsigned int end_byte, short **data)
 {
