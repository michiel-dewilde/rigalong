# Normalise line endings in the repository to LF.
#
# This project is developed on Windows but every file here is read by tools that
# expect LF: the NDK toolchain, gradlew when it runs under Git Bash, and the
# shell scripts in tools/. Storing LF and checking out LF keeps diffs honest and
# stops a stray CRLF from turning a script into "bad interpreter".
* text=auto eol=lf

# Scripts that MUST keep LF and stay executable.
gradlew         text eol=lf
*.sh            text eol=lf
*.py            text eol=lf

# The one Windows-only script, which needs CRLF to work at all.
gradlew.bat     text eol=crlf

# Binary: never normalised, never diffed as text.
*.jar           binary
*.png           binary
*.jpg           binary
*.mp4           binary
*.mov           binary
*.wav           binary
*.flac          binary
*.so            binary
*.apk           binary
*.keystore      binary
# DX7 cartridges: 4104 bytes of SysEx. Normalising line endings in these would
# corrupt them silently -- 0x0D and 0x0A are ordinary parameter values.
*.syx           binary
*.jks           binary

# Documentation carries the reasoning for this project and is worth diffing well.
*.md            text eol=lf diff=markdown

# Source, for the same reason.
*.c             text eol=lf diff=cpp
*.h             text eol=lf diff=cpp
*.cpp           text eol=lf diff=cpp
*.kt            text eol=lf diff=java
*.kts           text eol=lf diff=java
*.java          text eol=lf diff=java
